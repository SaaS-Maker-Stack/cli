import { {{ n.icon }}, MoreHorizontal, Pencil, Trash2 } from 'lucide-react';
import { Button } from '@/components/ui/button';
import { Card, CardContent } from '@/components/ui/card';
import {
  DropdownMenu,
  DropdownMenuContent,
  DropdownMenuItem,
  DropdownMenuTrigger,
} from '@/components/ui/dropdown-menu';
import { Skeleton } from '@/components/ui/skeleton';
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from '@/components/ui/table';
{% if choice_columns %}
import { {% for f in choice_columns %}{{ f.labels_name }}{{ ', ' if not loop.last }}{% endfor %} } from './choices';
{% endif %}
{% if status %}
import { {{ n.camel }}StatusBadge } from './{{ n.camel }}StatusBadge';
{% endif %}
import type { {{ n.camel }}Response } from '@/types/api';

interface {{ n.camel }}ListProps {
  items: {{ n.camel }}Response[];
  total: number;
  page: number;
  pageSize: number;
  isLoading: boolean;
  error: unknown;
  canWrite: boolean;
  hasFilters: boolean;
  onPageChange: (page: number) => void;
  onEdit: (item: {{ n.camel }}Response) => void;
  onDelete: (item: {{ n.camel }}Response) => void;
  onRetry: () => void;
  onCreate: () => void;
}

const dateFormatter = new Intl.DateTimeFormat('es', { dateStyle: 'medium' });
{% if has_datetime_col %}
const dateTimeFormatter = new Intl.DateTimeFormat('es', { dateStyle: 'medium', timeStyle: 'short' });
{% endif %}
{% if has_money_col %}
// Amount only: the currency (if any) is the module's business rule
const moneyFormatter = new Intl.NumberFormat('es', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
{% endif %}

/**
 * Implements the four states from DESIGN.md → States:
 * loading (skeleton rows), error (inline + "Reintentar"), empty, populated.
 */
export function {{ n.camel }}List({
  items,
  total,
  page,
  pageSize,
  isLoading,
  error,
  canWrite,
  hasFilters,
  onPageChange,
  onEdit,
  onDelete,
  onRetry,
  onCreate,
}: {{ n.camel }}ListProps) {
  if (error) {
    return (
      <Card>
        <CardContent className="flex flex-col items-center justify-center gap-3 py-12">
          <p className="text-sm text-destructive">No se pudieron cargar {{ n.article_plural }} {{ n.label_plural_lower }}.</p>
          <Button variant="outline" onClick={onRetry}>
            Reintentar
          </Button>
        </CardContent>
      </Card>
    );
  }

  if (!isLoading && items.length === 0) {
    return (
      <Card>
        <CardContent className="flex flex-col items-center justify-center py-12">
          <{{ n.icon }} className="h-12 w-12 text-muted-foreground/50" />
          <h3 className="mt-4 text-lg font-medium">
            {hasFilters ? 'Sin resultados' : 'Aún no hay {{ n.label_plural_lower }}'}
          </h3>
          <p className="mt-1 text-sm text-muted-foreground">
            {hasFilters
              ? 'Prueba con otro {{ title.label|lower }}{{ ' o estado' if status else '' }}.'
              : 'Crea {{ n.first_word }} {{ n.label_lower }} de tu organización.'}
          </p>
          {canWrite && !hasFilters && (
            <Button className="mt-4" onClick={onCreate}>
              {{ n.new_word }} {{ n.label_lower }}
            </Button>
          )}
        </CardContent>
      </Card>
    );
  }

  const totalPages = Math.max(1, Math.ceil(total / pageSize));

  return (
    <Card className="py-0">
      <Table>
        <TableHeader>
          <TableRow className="bg-muted/50">
            <TableHead>{{ title.label }}</TableHead>
{% for c in columns %}
            <TableHead className="{{ c.responsive }}">{{ c.field.label }}</TableHead>
{% endfor %}
{% if status %}
            <TableHead className="hidden sm:table-cell">Estado</TableHead>
{% endif %}
            <TableHead className="hidden md:table-cell">Creado</TableHead>
            {canWrite && <TableHead className="w-12" />}
          </TableRow>
        </TableHeader>
        <TableBody>
          {isLoading
            ? [...Array(3)].map((_, i) => (
                <TableRow key={i}>
                  <TableCell>
                    <Skeleton className="h-4 w-40" />
                  </TableCell>
{% for c in columns %}
                  <TableCell className="{{ c.responsive }}">
                    <Skeleton className="h-4 w-16" />
                  </TableCell>
{% endfor %}
{% if status %}
                  <TableCell className="hidden sm:table-cell">
                    <Skeleton className="h-4 w-16" />
                  </TableCell>
{% endif %}
                  <TableCell className="hidden md:table-cell">
                    <Skeleton className="h-4 w-24" />
                  </TableCell>
                  {canWrite && <TableCell />}
                </TableRow>
              ))
            : items.map((item) => (
                <TableRow key={item.id}>
                  <TableCell>
                    <div className="font-medium">{item.{{ title.name }}}</div>
{% if subtitle %}
                    {item.{{ subtitle.name }} && (
                      <div className="line-clamp-1 text-sm text-muted-foreground">
                        {item.{{ subtitle.name }}}
                      </div>
                    )}
{% endif %}
                  </TableCell>
{% for c in columns %}
                  <TableCell className="{{ c.responsive }}{{ ' ' ~ c.field.cell_class if c.field.cell_class else '' }}">
                    {{ c.field.cell_jsx('item') }}
                  </TableCell>
{% endfor %}
{% if status %}
                  <TableCell className="hidden sm:table-cell">
                    <{{ n.camel }}StatusBadge status={item.status} />
                  </TableCell>
{% endif %}
                  <TableCell className="hidden text-muted-foreground md:table-cell">
                    {dateFormatter.format(new Date(item.created_at))}
                  </TableCell>
                  {canWrite && (
                    <TableCell>
                      <DropdownMenu>
                        <DropdownMenuTrigger asChild>
                          <Button
                            variant="ghost"
                            size="sm"
                            aria-label={`Acciones de ${item.{{ title.name }}}`}
                          >
                            <MoreHorizontal className="h-4 w-4" />
                          </Button>
                        </DropdownMenuTrigger>
                        <DropdownMenuContent align="end">
                          <DropdownMenuItem onClick={() => onEdit(item)}>
                            <Pencil className="mr-2 h-4 w-4" />
                            Editar
                          </DropdownMenuItem>
                          <DropdownMenuItem variant="destructive" onClick={() => onDelete(item)}>
                            <Trash2 className="mr-2 h-4 w-4" />
                            Eliminar
                          </DropdownMenuItem>
                        </DropdownMenuContent>
                      </DropdownMenu>
                    </TableCell>
                  )}
                </TableRow>
              ))}
        </TableBody>
      </Table>

      {totalPages > 1 && (
        <div className="flex items-center justify-end gap-2 border-t px-4 py-3 text-sm text-muted-foreground">
          <span className="tabular-nums">
            Página {page} de {totalPages}
          </span>
          <Button
            variant="outline"
            size="sm"
            disabled={page <= 1}
            onClick={() => onPageChange(page - 1)}
          >
            Anterior
          </Button>
          <Button
            variant="outline"
            size="sm"
            disabled={page >= totalPages}
            onClick={() => onPageChange(page + 1)}
          >
            Siguiente
          </Button>
        </div>
      )}
    </Card>
  );
}
