import uuid

from httpx import AsyncClient

from tests.conftest import auth_headers, register

PREFIX = "{{ n.api_prefix }}"
TITLE = "{{ title.name }}"


def _payload(**overrides) -> dict:
    payload = {
{% for f in fields %}
        "{{ f.name }}": {{ f.py_sample }},
{% endfor %}
{% if status %}
        "status": "{{ status.default }}",
{% endif %}
    }
    payload.update(overrides)
    return payload


async def _add_member(client: AsyncClient, admin_tokens: dict, email: str, role: str) -> dict:
    invite = await client.post(
        "/organizations/members/invite",
        json={"email": email, "role": role},
        headers=auth_headers(admin_tokens),
    )
    assert invite.status_code == 201, invite.text
    accept = await client.post(
        "/auth/accept-invite",
        json={
            "token": invite.json()["token"],
            "full_name": "Nuevo Miembro",
            "password": "MemberPass123",
        },
    )
    assert accept.status_code == 201, accept.text
    return accept.json()


async def _create(client: AsyncClient, tokens: dict, **overrides) -> dict:
    response = await client.post(PREFIX, json=_payload(**overrides), headers=auth_headers(tokens))
    assert response.status_code == 201, response.text
    return response.json()


# --- CRUD -------------------------------------------------------------------


async def test_create_and_get(client: AsyncClient, owner_tokens: dict):
    created = await _create(client, owner_tokens)
    assert created[TITLE] == {{ title.py_sample }}
    assert created["created_by"] is not None

    fetched = await client.get(f"{PREFIX}/{created['id']}", headers=auth_headers(owner_tokens))
    assert fetched.status_code == 200
    assert fetched.json() == created


async def test_list_is_paginated_newest_first_and_searchable(
    client: AsyncClient, owner_tokens: dict
):
    for value in ["Alpha", "Beta", "Gamma"]:
        await _create(client, owner_tokens, **{TITLE: value})

    page = await client.get(PREFIX, params={"page_size": 2}, headers=auth_headers(owner_tokens))
    assert page.status_code == 200
    body = page.json()
    assert body["total"] == 3 and body["page"] == 1 and body["page_size"] == 2
    assert [item[TITLE] for item in body["items"]] == ["Gamma", "Beta"]

    page2 = await client.get(
        PREFIX, params={"page_size": 2, "page": 2}, headers=auth_headers(owner_tokens)
    )
    assert [item[TITLE] for item in page2.json()["items"]] == ["Alpha"]

    search = await client.get(PREFIX, params={"q": "bet"}, headers=auth_headers(owner_tokens))
    assert [item[TITLE] for item in search.json()["items"]] == ["Beta"]
{% if status %}

    await _create(client, owner_tokens, **{TITLE: "Last one", "status": "{{ status.last }}"})
    filtered = await client.get(
        PREFIX, params={"status": "{{ status.last }}"}, headers=auth_headers(owner_tokens)
    )
    assert [item[TITLE] for item in filtered.json()["items"]] == ["Last one"]
{% endif %}


async def test_update_and_delete(client: AsyncClient, owner_tokens: dict):
    created = await _create(client, owner_tokens)

    updated = await client.put(
        f"{PREFIX}/{created['id']}",
        json={TITLE: "Editado"{{ ', "status": "' ~ status.last ~ '"' if status else '' }}},
        headers=auth_headers(owner_tokens),
    )
    assert updated.status_code == 200
    assert updated.json()[TITLE] == "Editado"
{% if status %}
    assert updated.json()["status"] == "{{ status.last }}"
{% endif %}
{% if fields|length > 1 %}
    assert updated.json()["{{ fields[1].name }}"] == created["{{ fields[1].name }}"]  # untouched
{% endif %}
    assert updated.json()["updated_at"] >= created["updated_at"]

    deleted = await client.delete(f"{PREFIX}/{created['id']}", headers=auth_headers(owner_tokens))
    assert deleted.status_code == 204

    gone = await client.get(f"{PREFIX}/{created['id']}", headers=auth_headers(owner_tokens))
    assert gone.status_code == 404


async def test_validation(client: AsyncClient, owner_tokens: dict):
    headers = auth_headers(owner_tokens)
    assert (
        await client.post(PREFIX, json=_payload(**{TITLE: ""}), headers=headers)
    ).status_code == 422
{% if status %}
    assert (
        await client.post(PREFIX, json=_payload(status="weird"), headers=headers)
    ).status_code == 422
{% endif %}
    assert (await client.get(f"{PREFIX}/not-a-uuid", headers=headers)).status_code == 422
    assert (await client.get(f"{PREFIX}/{uuid.uuid4()}", headers=headers)).status_code == 404


# --- Roles ------------------------------------------------------------------


async def test_member_can_read_but_not_write(client: AsyncClient, owner_tokens: dict):
    item = await _create(client, owner_tokens)
    member = await _add_member(client, owner_tokens, "member@example.com", "member")
    headers = auth_headers(member)

    assert (await client.get(PREFIX, headers=headers)).json()["total"] == 1
    assert (await client.get(f"{PREFIX}/{item['id']}", headers=headers)).status_code == 200

    assert (await client.post(PREFIX, json=_payload(), headers=headers)).status_code == 403
    assert (
        await client.put(f"{PREFIX}/{item['id']}", json={TITLE: "No"}, headers=headers)
    ).status_code == 403
    assert (await client.delete(f"{PREFIX}/{item['id']}", headers=headers)).status_code == 403


async def test_admin_can_write(client: AsyncClient, owner_tokens: dict):
    admin = await _add_member(client, owner_tokens, "admin@example.com", "admin")
    item = await _create(client, admin, **{TITLE: "Por admin"})
    assert (
        await client.put(
            f"{PREFIX}/{item['id']}", json={TITLE: "Editado"}, headers=auth_headers(admin)
        )
    ).json()[TITLE] == "Editado"
    assert (
        await client.delete(f"{PREFIX}/{item['id']}", headers=auth_headers(admin))
    ).status_code == 204


async def test_requires_authentication(client: AsyncClient):
    assert (await client.get(PREFIX)).status_code == 401
    assert (await client.post(PREFIX, json=_payload())).status_code == 401


# --- Isolation between organizations ----------------------------------------


async def test_other_organization_cannot_see_or_touch(client: AsyncClient):
    acme = await register(client)
    globex = await register(
        client, email="globex@example.com", organization_name="Globex", full_name="Gina"
    )
    acme_item = await _create(client, acme, **{TITLE: "Acme only"})
    await _create(client, globex, **{TITLE: "Globex only"})

    # Listing only shows the caller's organization
    acme_list = await client.get(PREFIX, headers=auth_headers(acme))
    assert [item[TITLE] for item in acme_list.json()["items"]] == ["Acme only"]
    globex_list = await client.get(PREFIX, headers=auth_headers(globex))
    assert [item[TITLE] for item in globex_list.json()["items"]] == ["Globex only"]

    # Direct access from the other organization looks like "not found"
    other = auth_headers(globex)
    item_id = acme_item["id"]
    assert (await client.get(f"{PREFIX}/{item_id}", headers=other)).status_code == 404
    assert (
        await client.put(f"{PREFIX}/{item_id}", json={TITLE: "Hacked"}, headers=other)
    ).status_code == 404
    assert (await client.delete(f"{PREFIX}/{item_id}", headers=other)).status_code == 404

    # ...and the row is intact
    still = await client.get(f"{PREFIX}/{item_id}", headers=auth_headers(acme))
    assert still.status_code == 200 and still.json()[TITLE] == "Acme only"


async def test_switching_organization_switches_rows(client: AsyncClient):
    """A multi-org user sees the rows of the organization their session is scoped to."""
    acme = await register(client)
    globex = await register(
        client, email="globex@example.com", organization_name="Globex", full_name="Gina"
    )
    await _create(client, acme, **{TITLE: "Acme only"})
    await _create(client, globex, **{TITLE: "Globex only"})

    # Acme's owner joins Globex as admin
    invite = await client.post(
        "/organizations/members/invite",
        json={"email": "owner@example.com", "role": "admin"},
        headers=auth_headers(globex),
    )
    assert invite.status_code == 201
    joined = await client.post(
        "/auth/accept-invite",
        json={"token": invite.json()["token"], "full_name": "Olivia", "password": "SuperSecret123"},
    )
    assert joined.status_code == 201

    orgs = (await client.get("/auth/organizations", headers=auth_headers(acme))).json()
    globex_id = next(o["id"] for o in orgs if o["name"] == "Globex")
    switched = await client.post(
        "/auth/switch-organization",
        json={"organization_id": globex_id, "refresh_token": acme["refresh_token"]},
        headers=auth_headers(acme),
    )
    assert switched.status_code == 200

    listed = await client.get(PREFIX, headers=auth_headers(switched.json()))
    assert [item[TITLE] for item in listed.json()["items"]] == ["Globex only"]
