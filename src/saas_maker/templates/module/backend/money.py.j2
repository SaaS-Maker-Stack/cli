"""Money types shared by every schema with an amount (generated by saas-maker).

Amounts are `Numeric(14, 2)` in the table and `Decimal` in Python, never float.
Do the arithmetic here in `Decimal`; the frontend only formats.
"""

from decimal import Decimal
from typing import Annotated

from pydantic import Field, PlainSerializer

# What the API accepts: exact, never negative, two decimals
Price = Annotated[Decimal, Field(ge=0, max_digits=14, decimal_places=2)]
# Pydantic would emit a Decimal as a string; the frontend wants a number
PriceOut = Annotated[Decimal, PlainSerializer(float, return_type=float, when_used="json")]
